CC = g++
CFLAGS = -I
TARGET = serie_fibonacci
SRC = serie_fibonacci.cc

all: $(TARGET)

$(TARGET): $(SRC)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(SRC)

clean:
	rm -f $(TARGET)
