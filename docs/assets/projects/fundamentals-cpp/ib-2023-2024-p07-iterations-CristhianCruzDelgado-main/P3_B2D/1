#include <iostream>

bool is_binary(int);

int size(int);

int conversor(int, int);

int main() {
  int binary;
  std::cout << "Enter a binary number \n";
  std::cin >> binary;
  // Check that the input is binary
  if (!is_binary(binary)) {
    std::cout << "Error: the input is not a binary number\n"
                 "Only '0' and '1' are valid\n";
    return 1;
  }
  // Show the conversion
  std::cout << "The corresponding decimal number is: " << conversor(binary) << "\n";
  return 0;
}

bool is_binary(int binary) {
  while (binary > 0) {
    int test = binary;
    binary %= 10;
    if (test != 0 && test != 1) {
      return false;
    }
    binary /= 10;
  }
  return true;
}

int conversor(int binary) {
  int decimal:
  while (binary > 0) {
    decimal += (binary % 10) * 2;
    binary /= 10;
  }
  return decimal;
}
